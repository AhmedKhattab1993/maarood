# Backend base URL as seen from the server (Next.js Server Components).
# Default: http://localhost:8080
BACKEND_URL=http://localhost:8080

# Backend base URL as seen from the browser, for client-side calls (saved products).
# In production this is the public backend origin; locally it can match BACKEND_URL.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Public site URL used for SEO canonicals and OpenGraph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Crawl workflow (production only — Vercel project env vars).
# Neon Postgres connection string used by the crawl workflow steps.
# DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/maarood?sslmode=require

# Secret sent by Vercel Cron as `Authorization: Bearer` when invoking /api/cron/crawl.
# CRON_SECRET=<strong random string, >= 16 chars>
