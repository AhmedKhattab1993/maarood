{
  "name": "maarood",
  "version": "0.1.0",
  "private": true,
  "description": "Maarood — shopping-discovery platform for Egyptian brands.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace apps/backend",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:up": "docker compose up -d db && docker compose exec -T db pg_isready -U maarood -d maarood",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate --workspace @maarood/schema",
    "seed": "npm run build --workspace @maarood/scraper --if-present && node apps/scraper/dist/seed.js",
    "scrape": "npm run build --workspace @maarood/scraper --if-present && node apps/scraper/dist/main.js",
    "scrape:all": "npm run build --workspace @maarood/scraper --if-present && node apps/scraper/dist/run-all.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
