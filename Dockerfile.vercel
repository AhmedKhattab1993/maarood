# Container image for the Maarood backend on Vercel (Vercel Services).
# The build context is the REPO ROOT because the backend imports workspace
# packages: @maarood/schema (canonical Drizzle schema) and @maarood/scraper
# (crawl pipeline — the backend runs crawls in-process, triggered by Vercel
# Cron via GET /admin/crawl).
#
# Vercel injects PORT; the backend reads it at boot (default 8080 locally).

# ---- build ----
FROM node:20-bookworm-slim AS build
WORKDIR /app

# Install workspace manifests first for better layer caching.
COPY package.json package-lock.json* ./
COPY packages/schema/package.json ./packages/schema/package.json
COPY apps/backend/package.json ./apps/backend/package.json
COPY apps/scraper/package.json ./apps/scraper/package.json
RUN npm install --workspaces --include-workspace-root

# Compile in dependency order: schema -> scraper -> backend (the backend
# type-checks against the other two packages' dist output).
COPY tsconfig.base.json ./
COPY packages/schema ./packages/schema
RUN npm run build --workspace @maarood/schema

COPY apps/scraper ./apps/scraper
RUN npm run build --workspace @maarood/scraper

COPY apps/backend ./apps/backend
RUN npm run build --workspace @maarood/backend

# Prune devDependencies for the runtime image.
RUN npm prune --omit=dev

# ---- runtime ----
FROM node:20-bookworm-slim AS runtime
# curl is required by the Shopify connector: many stores sit behind Cloudflare,
# which fingerprints Node's TLS stack and serves a sanitized feed (discounts
# stripped). curl's TLS fingerprint receives the true product payload.
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
WORKDIR /app

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/schema/dist ./packages/schema/dist
COPY --from=build /app/packages/schema/package.json ./packages/schema/package.json
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/apps/backend/dist ./apps/backend/dist
COPY --from=build /app/apps/backend/package.json ./apps/backend/package.json
COPY --from=build /app/apps/scraper/dist ./apps/scraper/dist
COPY --from=build /app/apps/scraper/package.json ./apps/scraper/package.json

ENV PORT=8080
EXPOSE 8080

CMD ["node", "apps/backend/dist/main.js"]
